    { "name": "Sun-dried tomato paste", "amount": "5 tbsp" },
    { "name": "Aleppo pepper", "amount": "2 tsp" },
    { "name": "Butter beans in water", "amount": "2 × 400g tins" },
    { "name": "Vegetable stock cube", "amount": "1" },
    { "name": "Tahini", "amount": "3 tbsp" },
    { "name": "Freshly ground black pepper", "amount": "½ tsp" },
    { "name": "Pine nuts", "amount": "3 tbsp (30g)" },
