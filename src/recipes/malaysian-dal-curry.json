    { "name": "Rapeseed oil", "amount": "3 tbsp" },
    { "name": "Curry leaves", "amount": "10, fresh or frozen" },
    { "name": "Lemongrass", "amount": "1 stick" },
    { "name": "Star anise", "amount": "2" },
    { "name": "Large onion", "amount": "1" },
    { "name": "Garlic cloves", "amount": "2" },
    { "name": "Ground coriander", "amount": "1 tsp" },
    { "name": "Ground cumin", "amount": "1 tsp" },
    { "name": "Ground turmeric", "amount": "½ tsp" },
    { "name": "Kashmiri chilli", "amount": "1½ tsp" },
    { "name": "Tomato puree", "amount": "1½ tbsp" },
    { "name": "Red lentils", "amount": "300g" },
    { "name": "Fine sea salt", "amount": "1¼ tsp" },
    { "name": "Medium carrots", "amount": "2 (150g)" },
    { "name": "Coconut milk", "amount": "1 × 400ml tin" },
    { "name": "Tamarind paste", "amount": "1½ tbsp" },
    { "name": "Crispy chilli oil", "amount": "to serve" }
  ],
  "instructions": [
    "Bruise the lemongrass. Peel and finely chop the onion, peel and mince the garlic, and peel the carrots and cut them into 1cm cubes.",
    "Warm the oil in a large saucepan on a medium heat. Add the curry leaves, lemongrass and star anise and cook until the leaves crackle. Stir in the onion and cook for about 6 minutes, until soft and translucent, then add the garlic and cook for 2 minutes more.",
    "Add the coriander, cumin, turmeric and chilli and stir to mix. Add the tomato puree, lentils and salt and cook for 2 minutes.",
    "Add the carrots and coconut milk, then fill the empty coconut milk tin twice with tap water and add that too. Cook, stirring occasionally, for 20 to 25 minutes, until the dal is thick and the carrots are tender.",
    "Stir through the tamarind paste, then taste and adjust the salt, chilli or tamarind. Serve topped with a spoonful of crispy chilli oil, with paratha or steamed rice."
  ],
