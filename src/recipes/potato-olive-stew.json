        { "name": "Tomato purée", "amount": "1 tsp" },
        { "name": "Garlic cloves", "amount": "2", "note": "finely chopped" },
        { "name": "Unrefined sugar", "amount": "1 tsp" },
        { "name": "Ground cumin", "amount": "1 tsp" },
        { "name": "Turmeric", "amount": "1 tsp" },
        { "name": "Smoked paprika", "amount": "1 tsp" },
        { "name": "Hot chilli", "amount": "a pinch" },
        { "name": "Salt and black pepper", "amount": "to taste", "note": "stir, heat to low" }
      ]
